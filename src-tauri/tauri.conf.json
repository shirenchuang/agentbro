{
  "$schema": "https://raw.githubusercontent.com/nicedoctor/tauri-config-schema/v2/schema.json",
  "productName": "AgentBro",
  "identifier": "com.agentbro.desktop",
  "version": "3.1.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1423",
    "beforeDevCommand": "pnpm build:bridge && pnpm dev",
    "beforeBuildCommand": "pnpm build:bridge:release && pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "title": "AgentBro",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "width": 420,
        "height": 52,
        "x": null,
        "y": 0,
        "visible": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/pets/**",
          "$RESOURCE/themes/**",
          "$HOME/.agentbro/pets/**",
          "$HOME/.codex/pets/**",
          "$HOME/.config/agentbro/themes/**",
          "$APPCACHE/pet-asar-cache/**",
          "/Applications/Codex.app/Contents/Resources/webview/assets/**",
          "$HOME/Applications/Codex.app/Contents/Resources/webview/assets/**",
          "$LOCALDATA/OpenAI/Codex/app/resources/webview/assets/**",
          "$LOCALDATA/Programs/Codex/resources/webview/assets/**",
          "$LOCALDATA/Programs/Codex/app/resources/webview/assets/**",
          "C:/Program Files/WindowsApps/OpenAI.Codex_*/app/resources/webview/assets/**",
          "C:/Program Files/WindowsApps/OpenAI.Codex_*/resources/webview/assets/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://agentbro.oss-cn-hangzhou.aliyuncs.com/latest.json",
        "https://github.com/shirenchuang/agentbro/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QjhGMjZCNDJFNzZGMQpSV1R4ZGk2MEpvOXJDUWVCSkhuMXZGV0VNNzlmL1dSa1JyUHlhZzF1djVFdzFPY0JLb21xVTlPTAo="
    },
    "deep-link": {
      "desktop": {
        "schemes": ["agentbro", "ccswitch"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/pets": "pets",
      "../src/themes": "themes",
      "target/agentbro-bridge-resource/agentbro-bridge": "agentbro-bridge"
    }
  }
}

{
  "name": "agentbro",
  "private": true,
  "version": "2.4.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:bridge": "node scripts/build-bridge.mjs",
    "build:bridge:release": "node scripts/build-bridge.mjs --release",
    "tauri:dev": "pnpm build:bridge && cargo tauri dev",
    "tauri:build": "pnpm build:bridge:release && cargo tauri build --bundles app,dmg --no-sign --ci --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "tauri:build:windows": "node scripts/build-windows.mjs",
    "release:check": "node scripts/check-release-readiness.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "framer-motion": "^12",
    "i18next": "^26.0.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.3",
    "react-markdown": "^9",
    "remark-gfm": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.5"
  }
}
